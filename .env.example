# Export variables in your shell/process secret store; .env is not auto-loaded.
# Never commit real credentials.
BINANCE_TESTNET_HTTP_URL=https://testnet.binancefuture.com
BINANCE_TESTNET_WS_URL=wss://fstream.binancefuture.com
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# Non-secret deterministic runtime controls.
APGE_SYMBOL=BTCUSDT
# Use different paths for dry-run and authenticated TESTNET.
APGE_DB_PATH=apge_dry_state.sqlite3
APGE_POSITION_LIMIT=0.005
APGE_MAX_INVENTORY=0.005
APGE_BASE_SIZE=0.001
APGE_LEVEL_COUNT=1
APGE_GRID_SPACING=100
APGE_CYCLE_INTERVAL_SECONDS=2
APGE_MAX_CYCLES=5

# Adaptive runner controls. APGE_GRID_SPACING is for the static validator only.
APGE_ADAPTIVE_INTERVAL=5m
APGE_REGIME_LOOKBACK=20
APGE_BASE_SPACING_BPS=8
APGE_MIN_SPACING_BPS=5
APGE_MAX_SPACING_BPS=60
APGE_VOLATILITY_SPACING_MULTIPLIER=1.5
APGE_MIN_SIZE_SCALE=0.40
APGE_SIZE_DECAY_BPS=35
APGE_SLIGHT_TREND_INVENTORY_BIAS_FRACTION=0.20
APGE_FUNDING_BIAS_CAP_FRACTION=0.08
APGE_FUNDING_REFERENCE_RATE=0.0001
APGE_TARGET_INVENTORY_CAP_FRACTION=0.30
APGE_INVENTORY_SKEW_STRENGTH=1.0
